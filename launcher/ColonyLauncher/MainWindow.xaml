<Window x:Class="ColonyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColonyLauncher"
        Title="Colony Game" Width="1060" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/icon.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

  <Border x:Name="Frame" CornerRadius="14" Background="{StaticResource Bg}" BorderBrush="{StaticResource Frame}" BorderThickness="1">
    <Grid x:Name="Root">

      <!-- The world, and shade over it where text sits. -->
      <Canvas ClipToBounds="True">
        <l:WorldBackdrop x:Name="Map" />
      </Canvas>
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E60d0b0a" Offset="0" />
            <GradientStop Color="#A60d0b0a" Offset="0.36" />
            <GradientStop Color="#1A0d0b0a" Offset="0.56" />
            <GradientStop Color="#1A0d0b0a" Offset="0.64" />
            <GradientStop Color="#800d0b0a" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B30d0b0a" Offset="0" />
            <GradientStop Color="#000d0b0a" Offset="0.12" />
            <GradientStop Color="#000d0b0a" Offset="0.62" />
            <GradientStop Color="#D90d0b0a" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: drag to move; − ×. -->
        <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="OnDrag">
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
            <l:GlyphIcon Glyph="☼" Foreground="{StaticResource Accent}" Pixel="2" />
            <TextBlock Text="COLONY GAME" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="· launcher" Margin="8,0,0,0" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="LauncherVersion" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Style="{StaticResource Chrome}" Click="OnMinimize" ToolTip="Minimise">
              <l:GlyphIcon Glyph="-" Foreground="{StaticResource Dim}" Pixel="1.6" />
            </Button>
            <Button Style="{StaticResource Chrome}" Click="OnClose" ToolTip="Close">
              <l:GlyphIcon Glyph="×" Foreground="{StaticResource Dim}" Pixel="1.6" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Title on the left; what's new on the right. -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
          </Grid.ColumnDefinitions>

          <StackPanel Margin="52,34,0,0" VerticalAlignment="Top">
            <Grid HorizontalAlignment="Left">
              <TextBlock Text="COLONY" FontSize="96" FontWeight="SemiBold" Foreground="{StaticResource AccentShade}" Margin="5,5,0,0" />
              <TextBlock Text="COLONY" FontSize="96" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
            </Grid>
            <TextBlock Text="dig deep · build big · grow a people" FontSize="17" Foreground="{StaticResource Text}" Margin="6,2,0,0" />
            <TextBlock TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left" Margin="6,14,0,0" LineHeight="21" Foreground="{StaticResource Dim}" FontSize="13"
                       Text="Lead a small colony into the mountains. Hollow out the rock, raise homes and workshops, and grow long chains of industry, alone or with friends online." />
            <StackPanel Orientation="Horizontal" Margin="6,18,0,0">
              <Border Background="#1Afff8ea" CornerRadius="999" Padding="10,3" Margin="0,0,8,0">
                <TextBlock Text="single player" FontSize="11" Foreground="{StaticResource Dim}" />
              </Border>
              <Border Background="#1Afff8ea" CornerRadius="999" Padding="10,3" Margin="0,0,8,0">
                <TextBlock Text="hot-seat" FontSize="11" Foreground="{StaticResource Dim}" />
              </Border>
              <Border Background="#1Afff8ea" CornerRadius="999" Padding="10,3">
                <TextBlock Text="online, 2-4 colonies" FontSize="11" Foreground="{StaticResource Dim}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Frame}" BorderThickness="1" CornerRadius="10"
                  Margin="0,14,28,18" Padding="20,16,12,14">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,8,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="WHAT'S NEW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Frame}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="NewsTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Hi}" TextWrapping="Wrap" Margin="0,0,8,0" />
              <TextBlock x:Name="NewsDate" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,3,8,10" />
              <Button x:Name="NewsLink" DockPanel.Dock="Bottom" Style="{StaticResource Link}" Content="Full release notes ↗" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnReleasePage" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NewsBody" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" LineHeight="19" Margin="0,0,10,0" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>

        <!-- Status, progress and actions. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Frame}" BorderThickness="1" CornerRadius="10"
                Margin="28,0,28,24" Padding="24,18,20,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <l:GlyphIcon x:Name="StatusIcon" Glyph="•" Foreground="{StaticResource Dim}" Pixel="2" />
              <TextBlock x:Name="StatusText" Margin="12,0,0,0" FontSize="15" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusDetail" Grid.Row="1" Margin="22,4,0,0" FontSize="12" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />

            <Grid x:Name="ProgressRow" Grid.Row="2" Margin="22,12,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Track" Height="5" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center" SizeChanged="OnTrackSized">
                <Border x:Name="Fill" Height="5" CornerRadius="3" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0" />
              </Border>
              <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="14,0,0,0" FontSize="12" Foreground="{StaticResource Dim}" MinWidth="64" TextAlignment="Right" />
            </Grid>

            <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
              <Button x:Name="CheckButton" Style="{StaticResource Pill}" Click="OnCheck" Margin="0,0,10,0" ToolTip="Ask GitHub for the newest version">
                <StackPanel Orientation="Horizontal">
                  <l:GlyphIcon Glyph="↻" Foreground="{StaticResource Accent}" Pixel="1.6" Margin="0,0,8,0" />
                  <TextBlock Text="Check for updates" Foreground="{StaticResource Accent}" />
                </StackPanel>
              </Button>
              <Button x:Name="SecondButton" Style="{StaticResource Pill}" Click="OnSecond" Margin="0,0,14,0" Visibility="Collapsed">
                <TextBlock x:Name="SecondText" Foreground="{StaticResource Accent}" />
              </Button>
              <Button x:Name="MainButton" Style="{StaticResource Primary}" Click="OnMain" MinWidth="200" Height="50" Padding="26,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="MainText" Text="PLAY" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}" VerticalAlignment="Center" />
                  <l:GlyphIcon x:Name="MainIcon" Glyph="►" Foreground="{StaticResource AccentInk}" Pixel="2" Margin="12,0,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Links along the bottom. -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="20,14,0,0" x:Name="Links">
              <Button Style="{StaticResource Link}" Content="Saves folder" Click="OnSaves" ToolTip="Your saved games and settings (kept when you update or uninstall)" />
              <TextBlock Text=" · " Foreground="{StaticResource Faint}" FontSize="12" />
              <Button x:Name="FilesLink" Style="{StaticResource Link}" Content="Game files" Click="OnFiles" />
              <TextBlock Text=" · " Foreground="{StaticResource Faint}" FontSize="12" />
              <Button Style="{StaticResource Link}" Content="All releases ↗" Click="OnReleases" />
              <TextBlock Text=" · " Foreground="{StaticResource Faint}" FontSize="12" />
              <Button Style="{StaticResource Link}" Content="Licenses" Click="OnLicenses" />
              <TextBlock x:Name="UninstallDot" Text=" · " Foreground="{StaticResource Faint}" FontSize="12" />
              <Button x:Name="UninstallLink" Style="{StaticResource Link}" Content="Uninstall" Click="OnUninstall" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- A dialog over everything (install options, uninstall, licenses). -->
      <Grid x:Name="Overlay" Visibility="Collapsed">
        <Rectangle Fill="#CC0d0b0a" />
        <Border Background="{StaticResource PanelSolid}" BorderBrush="{StaticResource Frame}" BorderThickness="1" CornerRadius="12"
                Width="560" MaxHeight="520" Padding="28,22,28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
              <l:GlyphIcon x:Name="DialogIcon" Glyph="☼" Foreground="{StaticResource Accent}" Pixel="2" />
              <TextBlock x:Name="DialogTitle" Margin="12,0,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Hi}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="DialogCancel" Style="{StaticResource Pill}" Margin="0,0,10,0" Click="OnDialogCancel">
                <TextBlock x:Name="DialogCancelText" Text="Cancel" Foreground="{StaticResource Accent}" />
              </Button>
              <Button x:Name="DialogOk" Style="{StaticResource Primary}" Padding="22,9" Click="OnDialogOk">
                <TextBlock x:Name="DialogOkText" Foreground="{StaticResource AccentInk}" FontWeight="SemiBold" />
              </Button>
            </StackPanel>
            <CheckBox x:Name="DialogCheck" DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="DialogBody" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="13" LineHeight="20" Margin="0,0,8,0" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
