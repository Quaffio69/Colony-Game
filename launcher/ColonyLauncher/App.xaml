<Application x:Class="ColonyLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- The game's Hearth theme (game/ui/glyph_themes.json). -->
    <Color x:Key="BgColor">#0d0b0a</Color>
    <Color x:Key="PanelColor">#1a1613</Color>
    <SolidColorBrush x:Key="Bg" Color="#0d0b0a" />
    <SolidColorBrush x:Key="Panel" Color="#E61a1613" />
    <SolidColorBrush x:Key="PanelSolid" Color="#1a1613" />
    <SolidColorBrush x:Key="Text" Color="#ece4d6" />
    <SolidColorBrush x:Key="Dim" Color="#a39886" />
    <SolidColorBrush x:Key="Faint" Color="#5e554b" />
    <SolidColorBrush x:Key="Hi" Color="#fff8ea" />
    <SolidColorBrush x:Key="Accent" Color="#f0a849" />
    <SolidColorBrush x:Key="AccentHover" Color="#f7bd6a" />
    <SolidColorBrush x:Key="AccentInk" Color="#1a1208" />
    <SolidColorBrush x:Key="AccentShade" Color="#8a5a24" />
    <SolidColorBrush x:Key="Good" Color="#9cc65a" />
    <SolidColorBrush x:Key="Warn" Color="#f0c24a" />
    <SolidColorBrush x:Key="Bad" Color="#ef6a4c" />
    <SolidColorBrush x:Key="Info" Color="#6ab8d8" />
    <SolidColorBrush x:Key="Frame" Color="#24FFF8EA" />
    <SolidColorBrush x:Key="Track" Color="#1AFFF8EA" />
    <SolidColorBrush x:Key="GhostFill" Color="#1Af0a849" />
    <SolidColorBrush x:Key="GhostHover" Color="#33f0a849" />

    <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Pill buttons, as in the game's Glyph UI: Primary (filled accent), Ghost (outlined), Link (text only). -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="{StaticResource GhostFill}" />
      <Setter Property="BorderBrush" Value="#99f0a849" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GhostHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <!-- A hard pixel shade under the pill, like the title's. -->
              <Border Background="{StaticResource AccentShade}" CornerRadius="999" Margin="0,3,0,-3" />
              <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="RenderTransform">
                  <Setter.Value><TranslateTransform Y="2" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Padding="2,1" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Accent}" />
                <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="T" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title bar buttons (− ×), as on the game's windows. -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#1Afff8ea" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#40fff8ea" CornerRadius="3" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <!-- A switch, as in the game. -->
              <Border x:Name="Track" Width="28" Height="16" CornerRadius="8" Background="{StaticResource Track}" BorderBrush="{StaticResource Frame}" BorderThickness="1">
                <Border x:Name="Knob" Width="10" Height="10" CornerRadius="5" Background="{StaticResource Dim}" HorizontalAlignment="Left" Margin="2,0" />
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Knob" Property="Background" Value="{StaticResource AccentInk}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
